# Скопируйте в .env и заполните реальными значениями.

# SQLite для разработки. Для продакшена укажите строку подключения Postgres,
# например: postgresql://user:password@host:5432/english_start_profile
DATABASE_URL="file:./dev.db"

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО заменить на длинную случайную строку
# перед деплоем (например: openssl rand -base64 48).
JWT_SECRET="dev-only-secret-change-me"

PORT=4000

# Адрес фронтенда, с которого разрешены CORS-запросы с cookie.
FRONTEND_ORIGIN="http://localhost:5173"

# Использовать secure-cookie (только HTTPS). В проде — true.
COOKIE_SECURE=false

# ТОЛЬКО для локальной разработки/тестирования без email-провайдера:
# возвращает токен восстановления пароля прямо в ответе POST
# /api/auth/forgot-password и пишет его в лог сервера. По умолчанию
# (переменная не установлена) — токен НИГДЕ не появляется, восстановить
# доступ без реальной отправки письма невозможно. НИКОГДА не
# устанавливать true в продакшене — иначе любой, кто знает email
# пользователя, может захватить его аккаунт без доступа к почте.
EXPOSE_DEV_PASSWORD_RESET_TOKEN=false
