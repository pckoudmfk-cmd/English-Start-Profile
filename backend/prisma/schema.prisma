// English Start Profile — Этап 1: авторизация, роли, профили пользователей.
//
// Роль хранится как строка ("TEACHER" | "STUDENT" | "ADMIN"), а не как
// нативный enum БД: приложение использует SQLite в разработке и Postgres
// в проде, и мы не хотим завязываться на СУБД-специфичные enum'ы на этом
// этапе. Значение валидируется на уровне приложения (см. src/utils/roles.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String // TEACHER | STUDENT | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Токен восстановления доступа (см. раздел "Восстановление доступа").
  // Хранится в виде хэша, не в открытом виде.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  academicYears AcademicYear[]
  courses       Course[]
  groups        Group[]

  groupMemberships GroupMembership[]

  @@index([role])
}

// Профиль преподавателя. userId уникален -> связь 1:1 с User.
// Доступ на чтение/запись возможен только для владельца записи —
// см. src/routes/teacher.ts (поиск исключительно по req.user.id, без
// параметра id в маршруте).
model TeacherProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  organization String?
  department   String?
  position     String?
  workEmail    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Профиль студента. Та же модель изоляции, что и у TeacherProfile.
model StudentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  email        String?
  specialty    String?
  course       String?
  academicYear String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Этап 2: Teacher Workspace — учебные годы, курсы, группы, join-коды.
//
// Иерархия: Teacher -> AcademicYear -> Course -> Group.
// Каждая модель хранит teacherId НАПРЯМУЮ (а не только через цепочку
// связей) — по аналогии с ТЗ ("не полагаться только на student_id",
// раздел 83 SPEC.md): это защита в глубину, позволяющая проверять
// владение одним прямым условием в WHERE, без обхода цепочки JOIN'ов,
// где легко забыть проверку на промежуточном шаге.
//
// Членство студентов (GroupMembership) добавлено на Этапе 3.
// ---------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  // Преподаватель не может завести два учебных года с одинаковым названием.
  @@unique([teacherId, name])
  @@index([teacherId])
}

model Course {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  groups Group[]

  @@index([teacherId])
  @@index([academicYearId])
}

model Group {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  specialty String?
  status    String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  joinCodes   GroupJoinCode[]
  memberships GroupMembership[]

  @@index([teacherId])
  @@index([courseId])
}

// История join-кодов группы. Активен максимум один код одновременно —
// это гарантируется в коде приложения (routes/groups.ts), а не на
// уровне схемы. Старые коды не удаляются (revokedAt вместо DELETE),
// чтобы сохранить историю подключений по коду.
model GroupJoinCode {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code      String    @unique
  active    Boolean   @default(true)
  // Необязательный срок действия. На Этапе 2 преподаватель не может его
  // задать через интерфейс (всегда null = бессрочно) — колонка добавлена
  // на Этапе 3, чтобы код с истёкшим сроком действительно можно было
  // распознать и показать студенту сообщение "Срок действия истёк", а не
  // выдумывать этот сценарий. Управление сроком из UI — задача одного из
  // следующих этапов (Settings/Credit Settings).
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([groupId])
}

// Этап 3: членство студента в группе, созданное присоединением по коду.
//
// (studentId, groupId) уникальны — один студент не может состоять в одной
// и той же группе дважды; это и есть защита от дубликата membership,
// требуемая ТЗ. status оставлен на будущее (удаление студента из группы
// преподавателем — soft-delete, ещё не реализовано): сейчас всегда ACTIVE,
// но поле уже здесь, чтобы при появлении этой функции не пришлось менять
// смысл существующих строк задним числом.
model GroupMembership {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE") // ACTIVE | REMOVED
  // Код, которым студент воспользовался при присоединении — снимок на
  // момент подключения. Не ссылка на GroupJoinCode: тот код мог быть
  // потом регенерирован или деактивирован, а исторический факт "как
  // студент попал в группу" должен остаться читаемым.
  joinedViaCode String
  joinedAt      DateTime  @default(now())
  removedAt     DateTime?

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}
