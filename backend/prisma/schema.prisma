// English Start Profile — Этап 1: авторизация, роли, профили пользователей.
//
// Роль хранится как строка ("TEACHER" | "STUDENT" | "ADMIN"), а не как
// нативный enum БД: приложение использует SQLite в разработке и Postgres
// в проде, и мы не хотим завязываться на СУБД-специфичные enum'ы на этом
// этапе. Значение валидируется на уровне приложения (см. src/utils/roles.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String // TEACHER | STUDENT | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Токен восстановления доступа (см. раздел "Восстановление доступа").
  // Хранится в виде хэша, не в открытом виде.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  academicYears AcademicYear[]
  courses       Course[]
  groups        Group[]

  groupMemberships      GroupMembership[]
  questionnaireAttempts QuestionnaireAttempt[] @relation("QuestionnaireAttemptStudent")
  diagnosticAttempts    DiagnosticAttempt[]    @relation("DiagnosticAttemptStudent")
  teacherNotesAuthored  TeacherNote[]          @relation("TeacherNoteAuthor")
  teacherNotesAboutMe   TeacherNote[]          @relation("TeacherNoteStudent")
  goalStatusesAuthored  StudentGoalStatus[]    @relation("GoalStatusAuthor")
  goalStatusesAboutMe   StudentGoalStatus[]    @relation("GoalStatusStudent")
  achievementsAsStudent Achievement[]          @relation("AchievementStudent")
  achievementsReviewed  Achievement[]          @relation("AchievementTeacher")
  qualificationPoints   QualificationPoint[]

  // Этап 9: ДИФФЕРЕНЦИРОВАННЫЙ ЗАЧЁТ.
  creditSettingsAuthored        CreditSettings[]       @relation("CreditSettingsTeacher")
  dictionarySubmissions         DictionarySubmission[] @relation("DictionarySubmissionStudent")
  dictionarySubmissionsReviewed DictionarySubmission[] @relation("DictionarySubmissionTeacher")
  creditTestItemsAuthored       CreditTestItem[]       @relation("CreditTestItemTeacher")
  creditTestAttempts            CreditTestAttempt[]    @relation("CreditTestAttemptStudent")
  oralAssessmentsAsStudent      OralAssessment[]       @relation("OralAssessmentStudent")
  oralAssessmentsAssigned       OralAssessment[]       @relation("OralAssessmentAssignedBy")
  oralAssessmentsGraded         OralAssessment[]       @relation("OralAssessmentGradedBy")

  // Этап 10: ПРОМЕЖУТОЧНАЯ ДИАГНОСТИКА — кто из преподавателей назначил
  // конкретную попытку (заполнено только для kind="PROGRESS").
  questionnaireAttemptsAssigned QuestionnaireAttempt[] @relation("QuestionnaireAttemptAssignedBy")
  diagnosticAttemptsAssigned    DiagnosticAttempt[]    @relation("DiagnosticAttemptAssignedBy")

  @@index([role])
}

// Профиль преподавателя. userId уникален -> связь 1:1 с User.
// Доступ на чтение/запись возможен только для владельца записи —
// см. src/routes/teacher.ts (поиск исключительно по req.user.id, без
// параметра id в маршруте).
model TeacherProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  organization String?
  department   String?
  position     String?
  workEmail    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Профиль студента. Та же модель изоляции, что и у TeacherProfile.
model StudentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  email        String?
  specialty    String?
  course       String?
  academicYear String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Этап 2: Teacher Workspace — учебные годы, курсы, группы, join-коды.
//
// Иерархия: Teacher -> AcademicYear -> Course -> Group.
// Каждая модель хранит teacherId НАПРЯМУЮ (а не только через цепочку
// связей) — по аналогии с ТЗ ("не полагаться только на student_id",
// раздел 83 SPEC.md): это защита в глубину, позволяющая проверять
// владение одним прямым условием в WHERE, без обхода цепочки JOIN'ов,
// где легко забыть проверку на промежуточном шаге.
//
// Членство студентов (GroupMembership) добавлено на Этапе 3.
// ---------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  // Преподаватель не может завести два учебных года с одинаковым названием.
  @@unique([teacherId, name])
  @@index([teacherId])
}

model Course {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  groups Group[]

  @@index([teacherId])
  @@index([academicYearId])
}

model Group {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  specialty String?
  status    String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  joinCodes             GroupJoinCode[]
  memberships           GroupMembership[]
  questionnaireAttempts QuestionnaireAttempt[]
  diagnosticAttempts    DiagnosticAttempt[]
  teacherNotes          TeacherNote[]
  goalStatuses          StudentGoalStatus[]
  achievements          Achievement[]

  // Этап 9: ДИФФЕРЕНЦИРОВАННЫЙ ЗАЧЁТ — привязаны к группе (конкретному
  // учебному циклу студента), а не только к курсу.
  dictionarySubmissions DictionarySubmission[]
  creditTestAttempts    CreditTestAttempt[]
  oralAssessments       OralAssessment[]

  @@index([teacherId])
  @@index([courseId])
}

// История join-кодов группы. Активен максимум один код одновременно —
// это гарантируется в коде приложения (routes/groups.ts), а не на
// уровне схемы. Старые коды не удаляются (revokedAt вместо DELETE),
// чтобы сохранить историю подключений по коду.
model GroupJoinCode {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code      String    @unique
  active    Boolean   @default(true)
  // Необязательный срок действия. На Этапе 2 преподаватель не может его
  // задать через интерфейс (всегда null = бессрочно) — колонка добавлена
  // на Этапе 3, чтобы код с истёкшим сроком действительно можно было
  // распознать и показать студенту сообщение "Срок действия истёк", а не
  // выдумывать этот сценарий. Управление сроком из UI — задача одного из
  // следующих этапов (Settings/Credit Settings).
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([groupId])
}

// Этап 3: членство студента в группе, созданное присоединением по коду.
//
// (studentId, groupId) уникальны — один студент не может состоять в одной
// и той же группе дважды; это и есть защита от дубликата membership,
// требуемая ТЗ. status оставлен на будущее (удаление студента из группы
// преподавателем — soft-delete, ещё не реализовано): сейчас всегда ACTIVE,
// но поле уже здесь, чтобы при появлении этой функции не пришлось менять
// смысл существующих строк задним числом.
model GroupMembership {
  id            String    @id @default(uuid())
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status        String    @default("ACTIVE") // ACTIVE | REMOVED
  // Код, которым студент воспользовался при присоединении — снимок на
  // момент подключения. Не ссылка на GroupJoinCode: тот код мог быть
  // потом регенерирован или деактивирован, а исторический факт "как
  // студент попал в группу" должен остаться читаемым.
  joinedViaCode String
  joinedAt      DateTime  @default(now())
  removedAt     DateTime?

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}

// ---------------------------------------------------------------------
// Этап 4: START PROFILE — анкетирование (Q1–Q45, backend/src/questionnaire).
//
// Одна попытка = одна анкета для конкретной пары (студент, группа).
// student_id/course_id/group_id/academic_year_id хранятся на самой
// попытке (снимок на момент создания, а не только через group ->
// course -> academicYear) — по требованию ТЗ и по уже устоявшемуся в
// проекте принципу защиты в глубину (см. комментарий у AcademicYear/
// Course/Group выше). kind зарезервирован под будущие Progress Check /
// Credit Test — Этап 10 задействовал "PROGRESS" (см. ниже), "CREDIT"
// по-прежнему дремлет (Этап 9 сознательно его не использует).
//
// Завершённая попытка (status = COMPLETED) неизменяема: маршрут
// автосохранения ответа отклоняет запись, если попытка уже завершена
// — "исторические ответы не перезаписывать" из ТЗ.
//
// Этап 10 (Промежуточная диагностика): assignedByTeacherId/assignedAt/
// periodStartAt/periodEndAt — заполняются ТОЛЬКО для kind="PROGRESS",
// когда попытку создаёт преподаватель (ТЗ: "запустить может только
// преподаватель"), остаются null для kind="START" (студент создаёт её
// сам). status получает дополнительное значение "ASSIGNED" — попытка
// уже создана преподавателем, но студент её ещё не открывал (и не
// может открыть до periodStartAt — "пройти её раньше назначенного
// срока" запрещено ТЗ).
// ---------------------------------------------------------------------

model QuestionnaireAttempt {
  id             String    @id @default(uuid())
  studentId      String
  student        User      @relation("QuestionnaireAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId       String
  academicYearId String
  kind           String    @default("START") // START | PROGRESS | CREDIT (CREDIT дремлет, см. комментарий выше)
  status         String    @default("IN_PROGRESS") // ASSIGNED (только PROGRESS) | IN_PROGRESS | COMPLETED
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedByTeacherId String?
  assignedByTeacher   User?     @relation("QuestionnaireAttemptAssignedBy", fields: [assignedByTeacherId], references: [id])
  assignedAt          DateTime?
  periodStartAt       DateTime?
  periodEndAt         DateTime?

  answers QuestionnaireAnswer[]

  // Ровно одна попытка данного вида (START/PROGRESS/CREDIT) на пару
  // (студент, группа). Без этого ограничения "найти-или-создать" в
  // POST /attempts подвержено гонке: два параллельных запроса (двойной
  // клик, две вкладки, повторный запрос сети — на практике реально
  // воспроизводится двойным вызовом эффекта монтирования в React
  // StrictMode) оба видят "попытки ещё нет" и создают два разных ряда;
  // сохранённые ответы уходят в один, а более поздние чтения ("какая
  // попытка самая свежая") могут вернуть другой, пустой. Уникальный
  // индекс превращает это в конфликт на уровне БД, который обработчик
  // ловит и на который отвечает, отдавая уже существующую попытку.
  @@unique([studentId, groupId, kind])
  @@index([studentId])
  @@index([groupId])
}

// Один ответ на один вопрос анкеты в рамках попытки. valueJson хранит
// значение в JSON-виде (строка / массив строк / число / объект вида
// {навык: оценка}) — конкретная форма зависит от типа вопроса, см.
// backend/src/questionnaire/definition.ts. indexGroup — СНИМОК группы
// показателя (self-assessment/motivation/…) на момент ответа: если
// классификация вопроса в definition.ts когда-нибудь изменится, уже
// сохранённые исторические ответы не должны задним числом менять свою
// категорию — это и есть "подготовленные для аналитики данные" из ТЗ,
// без вычисления самих индексов на этом этапе.
model QuestionnaireAnswer {
  id           String               @id @default(uuid())
  attemptId    String
  attempt      QuestionnaireAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionCode String
  valueJson    String
  indexGroup   String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([attemptId, questionCode])
  @@index([attemptId])
}

// ---------------------------------------------------------------------
// Этап 5: START DIAGNOSTIC — объективная проверка языковых навыков.
// Отдельный модуль от анкетирования (свои модели, свои маршруты, свой
// экран) — не смешивается с QuestionnaireAttempt/QuestionnaireAnswer
// ни на уровне данных, ни на уровне UI.
//
// Банк заданий (вопросы, варианты, правильный ответ) — НЕ в БД, а в
// backend/src/diagnostic/itemBank.ts (по аналогии с анкетой в
// questionnaire/definition.ts): это статичный, курируемый контент без
// интерфейса редактирования, и, что важнее, правильные ответы не
// должны быть доступны клиенту — если бы банк заданий лежал в БД и
// отдавался вместе с попыткой, пришлось бы отдельно следить, чтобы
// correct-поле никогда не утекло в ответ API. Храня его в коде
// backend, "отдать вопрос без ответа" — это просто выбор, какие поля
// сериализовать, а не постоянная угроза случайной утечки.
// ---------------------------------------------------------------------

model DiagnosticAttempt {
  id             String    @id @default(uuid())
  studentId      String
  student        User      @relation("DiagnosticAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId       String
  academicYearId String
  kind           String    @default("START") // START | PROGRESS | CREDIT (CREDIT дремлет — см. комментарий у QuestionnaireAttempt)
  status         String    @default("IN_PROGRESS") // ASSIGNED (только PROGRESS) | IN_PROGRESS | COMPLETED
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Этап 10 — тот же приём назначения преподавателем, что и у
  // QuestionnaireAttempt (см. комментарий там): заполняется только для
  // kind="PROGRESS".
  assignedByTeacherId String?
  assignedByTeacher   User?     @relation("DiagnosticAttemptAssignedBy", fields: [assignedByTeacherId], references: [id])
  assignedAt          DateTime?
  periodStartAt       DateTime?
  periodEndAt         DateTime?

  answers DiagnosticAnswer[]
  result  DiagnosticResult?

  // Тот же урок, что и у QuestionnaireAttempt (см. комментарий там) —
  // защита от гонки при "найти-или-создать" на уровне БД, а не только
  // в коде обработчика.
  @@unique([studentId, groupId, kind])
  @@index([studentId])
  @@index([groupId])
}

// Один ответ на одно задание. itemId — идентификатор из статичного
// банка заданий (backend/src/diagnostic/itemBank.ts), не foreign key
// на таблицу БД — банк заданий не хранится в БД (см. комментарий выше).
// skill — снимок на момент ответа, по той же причине, что и
// indexGroup у QuestionnaireAnswer: если задание когда-нибудь
// переклассифицируют, исторический ответ не должен менять категорию
// задним числом.
model DiagnosticAnswer {
  id                  String            @id @default(uuid())
  attemptId           String
  attempt             DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  itemId              String
  skill               String // GRAMMAR | VOCABULARY | READING | LISTENING
  selectedOptionIndex Int
  correct             Boolean
  answeredAt          DateTime          @default(now())

  @@unique([attemptId, itemId])
  @@index([attemptId])
}

// Результат попытки — считается один раз при завершении
// (POST .../complete) и больше не пересчитывается (та же логика
// неизменяемости, что у завершённой QuestionnaireAttempt).
//
// skillBreakdownJson — [{skill, correct, total, percentage}] по
// каждому из реализованных навыков (Grammar/Vocabulary/Reading/
// Listening — Writing/Speaking пока не реализованы и в разбивке не
// участвуют).
//
// diagnosticRange — строго nullable и НИЧЕМ не заполняется на этом
// этапе: ТЗ прямо запрещает превращать процент в A1/A2/B1/B2 без
// утверждённой матрицы порогов. Поле существует в модели, потому что
// оно есть в требовании к архитектуре результата, но остаётся пустым,
// пока такая матрица не появится и не будет явно подтверждена — это
// осознанное решение, а не недоделанная часть.
model DiagnosticResult {
  id                 String            @id @default(uuid())
  attemptId          String            @unique
  attempt            DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  overallCorrect     Int
  overallTotal       Int
  overallPercentage  Float
  skillBreakdownJson String
  diagnosticRange    String?
  computedAt         DateTime          @default(now())
}

// ---------------------------------------------------------------------
// Этап 6: TEACHER DASHBOARD.
//
// Заметка преподавателя о студенте — в контексте конкретной группы
// (SPEC.md, TeacherComment). Пишет и видит только преподаватель,
// владеющий этой группой (проверяется по teacherId, тот же принцип
// защиты в глубину, что и everywhere else в проекте) — сам студент
// заметки не видит, это внутренний инструмент преподавателя.
// ---------------------------------------------------------------------

model TeacherNote {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation("TeacherNoteAuthor", fields: [teacherId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("TeacherNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  text      String
  // Этап 7: тип заметки (OBSERVATION|RECOMMENDATION|AGREEMENT|IMPORTANT|
  // EVENT_PREP) — nullable, чтобы не переписывать задним числом заметки,
  // созданные на Этапе 6 до появления этого поля (у них тип неизвестен,
  // а не "наблюдение по умолчанию" — честнее оставить null).
  noteType  String?
  createdAt DateTime @default(now())

  @@index([teacherId])
  @@index([groupId, studentId])
}

// ---------------------------------------------------------------------
// Этап 7: ПОЛНЫЙ ПРОФИЛЬ СТУДЕНТА — статусы целей (вкладка «Цели»).
//
// Цели студента как ТЕКСТ приходят из анкеты (Q37 — до 3 выбранных
// формулировок из фиксированного списка вариантов) и не редактируются
// задним числом (исторический ответ анкеты неизменяем — см. Этап 4).
// А вот СТАТУС достижения каждой цели — это не факт анкетирования, а
// текущая педагогическая оценка, которую явно меняет преподаватель
// (ТЗ Этапа 7, п.14: "не отмечать автоматически цель как выполненную").
// Поэтому статус хранится отдельно от QuestionnaireAnswer, ключом
// (groupId, studentId, goalCode), где goalCode — тот же machine-key
// варианта Q37, что и в анкете.
model StudentGoalStatus {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation("GoalStatusAuthor", fields: [teacherId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("GoalStatusStudent", fields: [studentId], references: [id], onDelete: Cascade)
  goalCode  String // machine-key варианта Q37 (например "speak_confidently")
  status    String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE | NOT_ACHIEVED
  updatedAt DateTime @updatedAt

  @@unique([groupId, studentId, goalCode])
  @@index([groupId, studentId])
}

// Приложение-only журнал изменений статуса цели (ТЗ п.21: "для важных
// действий сохранять кто/когда/что изменилось"). Append-only — строки
// никогда не обновляются и не удаляются, только добавляются при каждом
// PUT статуса.
model StudentGoalStatusEvent {
  id         String   @id @default(uuid())
  teacherId  String
  groupId    String
  studentId  String
  goalCode   String
  fromStatus String
  toStatus   String
  createdAt  DateTime @default(now())

  @@index([groupId, studentId, goalCode])
}

// ---------------------------------------------------------------------
// Этап 8: ДОСТИЖЕНИЯ, ВНЕАУДИТОРНАЯ ДЕЯТЕЛЬНОСТЬ, КВАЛИФИКАЦИОННЫЕ БАЛЛЫ.
//
// Базовое правило (ТЗ п.1, 36 — намеренно не расширяю): результативное
// мероприятие = 1 квалификационный балл, не больше, никаких других видов
// баллов/коэффициентов/баллов за посещение или волонтёрство.
//
// Заявленный студентом результат (claimedResult/resultPlace/…) — это
// только заявление, а не факт (ТЗ п.32): единственный источник истины о
// начисленном балле — отдельная модель QualificationPoint, создаваемая
// ТОЛЬКО явным действием преподавателя "Подтвердить — 1 балл". Поле
// Achievement.qualificationPoint — денормализованный кэш для быстрого
// отображения (0 или 1), а не источник истины.
// ---------------------------------------------------------------------

model Achievement {
  id             String @id @default(uuid())
  studentId      String
  student        User   @relation("AchievementStudent", fields: [studentId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Снимок на момент создания — тот же приём защиты в глубину, что и у
  // QuestionnaireAttempt/DiagnosticAttempt (см. комментарии там):
  // courseId/academicYearId не выводятся через group->course на лету,
  // чтобы будущий перевод группы в другой курс не переписывал задним
  // числом принадлежность уже поданных достижений.
  courseId       String
  academicYearId String

  eventName String
  eventDate DateTime
  organizer String
  // CONFERENCE | COMPETITION | OLYMPIAD | ACADEMIC | PROJECT | OTHER
  // (ТЗ п.5 — "не добавляй дополнительные категории без необходимости";
  // раздел 15 описывает те же категории прозой, отдельной таксономии не
  // завожу)
  eventType String

  // PARTICIPANT | PRIZE_PLACE | WINNER | PUBLISHED | NOMINATION_WINNER | OTHER
  claimedResult      String
  claimedResultOther String? // текст, если claimedResult = OTHER
  resultPlace        String? // например "II место" (ТЗ п.17, для PRIZE_PLACE)
  resultNomination   String? // название номинации (ТЗ п.18, для NOMINATION_WINNER)
  description        String?

  // DRAFT | PENDING | CONFIRMED | CONFIRMED_NO_POINT | REJECTED | NEEDS_CLARIFICATION
  status             String @default("DRAFT")
  // Денормализованный кэш 0/1 — источник истины см. QualificationPoint.
  qualificationPoint Int    @default(0)

  teacherId      String?
  teacher        User?   @relation("AchievementTeacher", fields: [teacherId], references: [id])
  teacherComment String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime? // DRAFT -> PENDING
  verifiedAt  DateTime? // последнее решение преподавателя (любое из 4)

  evidence                 AchievementEvidence[]
  qualificationPointRecord QualificationPoint?
  auditLog                 AchievementAuditLog[]

  @@index([studentId])
  @@index([groupId])
  @@index([status])
}

// Подтверждающие документы. Отдельная таблица (не одно поле на
// Achievement) — студент может приложить несколько документов
// (страница сборника + сертификат + диплом, ТЗ п.16), и это же место
// естественно расширить под будущие типы вложений (ТЗ п.37) без
// изменения формы Achievement. Файлы хранятся на диске
// (backend/uploads/achievements/), здесь — только метаданные;
// storedName — случайное имя на диске, НЕ оригинальное имя файла (защита
// от path traversal и коллизий).
model AchievementEvidence {
  id            String      @id @default(uuid())
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  fileName      String // оригинальное имя, показывается пользователю
  storedName    String // имя файла на диске (uuid + расширение)
  mimeType      String
  size          Int
  uploadedAt    DateTime    @default(now())

  @@index([achievementId])
}

// Начисленный квалификационный балл. achievementId уникален —
// защита от повторного начисления НА УРОВНЕ БД (ТЗ п.13: "не
// полагаться только на frontend"), а не только проверкой в коде
// маршрута: даже гонка двух параллельных "Подтвердить — 1 балл" не
// может создать вторую запись для одного достижения (тот же приём
// уникального индекса + обработка P2002, что и у QuestionnaireAttempt/
// DiagnosticAttempt на предыдущих этапах).
model QualificationPoint {
  id            String      @id @default(uuid())
  achievementId String      @unique
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId       String
  teacherId     String
  // Значение всегда 1 в этой версии (ТЗ п.36: "не создавай разные
  // значения баллов для разных мероприятий") — поле Int, а не
  // захардкоженная константа в коде, чтобы будущее расширение (ТЗ п.37)
  // не требовало миграции схемы, если правило когда-нибудь изменится.
  value         Int         @default(1)
  createdAt     DateTime    @default(now())

  @@index([studentId, groupId])
  @@index([groupId])
}

// Append-only журнал (ТЗ п.31) — тот же приём, что и
// StudentGoalStatusEvent на Этапе 7, но с более широким набором
// действий, т.к. у достижения не один переключаемый статус, а полный
// workflow с решениями преподавателя.
model AchievementAuditLog {
  id            String      @id @default(uuid())
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  actorId       String // студент или преподаватель, в зависимости от action
  // CREATED | SUBMITTED | EDITED | EVIDENCE_ADDED | EVIDENCE_REMOVED |
  // CLARIFICATION_REQUESTED | CONFIRMED | CONFIRMED_NO_POINT |
  // POINT_AWARDED | REJECTED | STATUS_REVERTED | POINT_REVOKED
  action        String
  fromValue     String?
  toValue       String?
  reason        String?
  createdAt     DateTime    @default(now())

  @@index([achievementId])
}

// ---------------------------------------------------------------------
// Этап 9: МОДУЛЬ «ДИФФЕРЕНЦИРОВАННЫЙ ЗАЧЁТ».
//
// Критическое разделение данных (ТЗ п.2): это ОТДЕЛЬНЫЙ учебный
// процесс со своими результатами/статусами/историей — ни одна из
// моделей ниже не использует QuestionnaireAttempt/DiagnosticAttempt
// (в т.ч. их зарезервированное, но никогда не заполнявшееся значение
// kind = "CREDIT" — оно намеренно остаётся неиспользуемым, чтобы не
// смешивать Start Diagnostic/Progress Check с зачётом) и ни одно из
// решений этого модуля не переносится автоматически в другой модуль.
//
// courseId/academicYearId хранятся как снимок строкой на каждой модели
// (тот же приём защиты в глубину, что и у Achievement/QuestionnaireAttempt
// выше) — без relation-объекта на Course, по тому же соглашению, что и
// у Achievement.
// ---------------------------------------------------------------------

// Настройки зачёта на курс (ТЗ п.14, 16 — "это настройка, значение по
// умолчанию 1/не всегда показывать ответы, преподаватель может
// изменить в будущем"). Ровно один ряд на курс. Управляющего интерфейса
// на этом этапе может не быть везде, но поля существуют как реальная
// настройка (не константа в коде), чтобы будущее изменение не требовало
// миграции.
model CreditSettings {
  id                   String   @id @default(uuid())
  courseId             String   @unique
  teacherId            String
  teacher              User     @relation("CreditSettingsTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  // ТЗ п.14: "количество попыток — это настройка, по умолчанию 1".
  maxTestAttempts      Int      @default(1)
  // ТЗ п.16: "показ правильных ответов зависит от политики курса —
  // не жёстко закодировано как всегда показывать". По умолчанию НЕ
  // показывать — это осознанно самый безопасный дефолт (не выдаёт
  // банк ответов без явного решения преподавателя), а не выдуманное
  // правило.
  revealCorrectAnswers Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Допуск к зачёту — предоставление активного словаря (ТЗ п.4-6).
// Каждая отправка — новая строка (не редактирование существующей):
// это тот же принцип "история не переписывается" (ТЗ п.33), что и у
// Achievement/AchievementAuditLog, и одновременно естественный ответ на
// сценарий "преподаватель отклонил / запросил уточнение — студент
// отправляет заново": вместо реюза одной изменяемой записи со сложной
// таблицей переходов статусов создаётся новая запись, а старая
// остаётся зафиксированным историческим фактом. "Текущий" статус
// допуска — статус САМОЙ ПОСЛЕДНЕЙ по времени отправки записи для пары
// (студент, группа).
//
// status: SUBMITTED (только что отправлено) | UNDER_REVIEW
// (преподаватель открыл карточку — явное действие "Открыть", ТЗ п.7) |
// NEEDS_CLARIFICATION | CONFIRMED | REJECTED. НИКОГДА не подтверждается
// автоматически, только явным действием преподавателя (ТЗ п.5).
model DictionarySubmission {
  id             String @id @default(uuid())
  studentId      String
  student        User   @relation("DictionarySubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId       String
  academicYearId String

  // Заявленное студентом количество слов (ТЗ п.6) — заявление, не факт;
  // подтверждение — только явное решение преподавателя (ТЗ п.5).
  wordCount   Int
  description String?
  link        String? // необязательная ссылка (ТЗ п.6)

  status         String    @default("SUBMITTED")
  teacherId      String?
  teacher        User?     @relation("DictionarySubmissionTeacher", fields: [teacherId], references: [id])
  teacherComment String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now()) // = дата отправки (submittedAt отдельного поля не нужно — запись создаётся уже "отправленной", черновика нет)

  files DictionarySubmissionFile[]

  @@index([studentId, groupId])
  @@index([groupId])
  @@index([status])
}

// Файлы допуска. Отдельная таблица (как AchievementEvidence) — можно
// приложить несколько файлов; формат НЕ ограничен одним типом (ТЗ
// п.6 — "не ограничивать реализацию только одним форматом файла"), см.
// uploads/dictionaryStorage.ts за расширенным (по сравнению с
// достижениями) списком допустимых MIME-типов.
model DictionarySubmissionFile {
  id           String               @id @default(uuid())
  submissionId String
  submission   DictionarySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  uploadedAt   DateTime             @default(now())

  @@index([submissionId])
}

// Банк заданий лексико-грамматического теста (ТЗ п.11) — в БД (в
// отличие от диагностического банка на Этапе 5, который в коде), потому
// что ТЗ п.10 прямо требует, чтобы преподаватель мог управлять банком
// (создавать/редактировать/деактивировать задания) — это принципиально
// не статичный курируемый контент. correctOptionIndex НЕ отдаётся
// студенту до завершения попытки (см. сериализацию в routes) — тот же
// принцип "не утекает через API", что и у DiagnosticAttempt, только
// обеспечивается выбором полей сериализации, а не расположением банка
// вне БД.
//
// grammarTopic — СТРОГО один из 11 значений ТЗ п.9 (перечислены в
// backend/src/credit/constants.ts), другие темы не добавляются без
// отдельного согласования (ТЗ п.37).
model CreditTestItem {
  id             String @id @default(uuid())
  teacherId      String
  teacher        User   @relation("CreditTestItemTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  courseId       String
  academicYearId String

  question           String // на английском (ТЗ п.11 — контент на английском)
  optionsJson        String // JSON-массив строк вариантов (английский)
  correctOptionIndex Int
  grammarTopic       String
  // Лексическая тема — текстом (не фиксированный список): словарь
  // должен браться из реальных материалов курса (ТЗ п.10), а не из
  // общего английского, поэтому это открытое поле, которое заполняет
  // сам преподаватель по своим материалам, а не выбор из выдуманного
  // здесь перечня.
  vocabularyTopic    String
  // EASY | MEDIUM | HARD — ТЗ требует само поле "difficulty", но не
  // определяет шкалу; выбрана минимальная трёхуровневая шкала как
  // самое скромное, безопасное допущение (задокументировано в отчёте
  // как решение, требующее подтверждения).
  difficulty         String  @default("MEDIUM")
  active             Boolean @default(true)
  // Пояснение к правильному ответу на русском (ТЗ п.11 — "объяснение
  // после проверки на русском"), необязательно.
  explanationRu      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([active])
}

// Попытка лексико-грамматического теста (ТЗ п.13-14). Каждая попытка —
// НОВАЯ строка, никогда не перезаписывается (ТЗ п.13, 33) — в отличие
// от DiagnosticAttempt (Этап 5), где на пару (студент, группа) ровно
// одна строка; здесь их может быть несколько, а число попыток
// ограничено настройкой CreditSettings.maxTestAttempts. attemptNumber —
// последовательный номер попытки этого студента в этой группе (1, 2, …);
// уникальный индекс на (studentId, groupId, attemptNumber) — та же
// защита от гонки на уровне БД, что и у QuestionnaireAttempt/
// DiagnosticAttempt: даже два одновременных запроса "начать попытку" не
// создадут два ряда с одинаковым номером.
model CreditTestAttempt {
  id             String @id @default(uuid())
  studentId      String
  student        User   @relation("CreditTestAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId       String
  academicYearId String
  attemptNumber  Int

  status       String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  correctCount Int?
  totalCount   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  answers CreditTestAnswer[]

  @@unique([studentId, groupId, attemptNumber])
  @@index([studentId, groupId])
}

// Один вопрос в рамках попытки. Все 10 строк создаются ОДНОВРЕМЕННО при
// старте попытки (не лениво при ответе, как DiagnosticAnswer) — это
// нужно, чтобы студент мог свободно перемещаться вперёд/назад и менять
// ответ до завершения (ТЗ п.12: "выбор/далее/назад/изменение ответа до
// завершения"), а не только отвечать по порядку один раз, как в
// диагностике.
//
// question/optionsSnapshot/correctOptionIndexSnapshot/grammarTopicSnapshot
// — СНИМОК соответствующих полей CreditTestItem на момент начала
// попытки (тот же приём, что и indexGroup/skill в QuestionnaireAnswer/
// DiagnosticAnswer): если преподаватель потом отредактирует или
// деактивирует задание в банке, уже пройденная попытка не должна
// задним числом измениться. itemId хранится как обычная строка (без
// FK-связи) — только для трассируемости "из какого задания банка
// взято", сама попытка полностью самодостаточна по снимку и не
// зависит от того, существует ли ещё эта строка в банке.
model CreditTestAnswer {
  id         String            @id @default(uuid())
  attemptId  String
  attempt    CreditTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  itemId     String
  orderIndex Int

  questionSnapshot           String
  optionsSnapshotJson        String
  correctOptionIndexSnapshot Int
  grammarTopicSnapshot       String

  selectedOptionIndex Int?
  correct             Boolean?
  answeredAt          DateTime?

  @@unique([attemptId, itemId])
  @@index([attemptId])
}

// Устная часть (ТЗ п.17-22, 25-26). Один ряд на пару (студент, группа) —
// один зачётный цикл имеет ровно одну устную часть (назначенную ЛИБО
// освобождённую), в отличие от DictionarySubmission/CreditTestAttempt,
// где допустимо много попыток/отправок. Правки статуса (назначение →
// черновик оценки → подтверждение) идут ОДНОЙ и той же строкой, а не
// новыми записями — устная часть не переотправляется студентом
// (в отличие от словаря), поэтому переиспользование строки здесь не
// нарушает "история не переписывается": это одна и та же процедура, а
// не серия независимых попыток.
//
// status: ASSIGNED (тема назначена, беседа/оценка ещё впереди) |
// GRADED_DRAFT (преподаватель заполнил критерии — есть предварительный
// результат, но НЕ подтверждён, ТЗ п.22) | CONFIRMED (итоговая оценка
// подтверждена преподавателем — только это и означает "устная часть
// завершена" для расчёта общего статуса, см. analytics/credit.ts) |
// EXEMPTED (освобождён по баллам, ТЗ п.25-26 — создаётся даже когда
// устная часть не проводилась, для истории).
model OralAssessment {
  id             String @id @default(uuid())
  studentId      String
  student        User   @relation("OralAssessmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId       String
  academicYearId String

  status String

  // Назначение темы (ТЗ п.19 — только преподаватель, без случайного
  // автоназначения). topicId — код одной из 17 утверждённых тем (ТЗ
  // п.18, см. constants.ts), null только для EXEMPTED.
  topicId             String?
  assignedByTeacherId String?
  assignedByTeacher   User?     @relation("OralAssessmentAssignedBy", fields: [assignedByTeacherId], references: [id])
  assignedAt          DateTime?
  assignedComment     String?

  // 6 критериев оценки (ТЗ п.21) — каждое поле хранит один из
  // фиксированных вариантов конкретного критерия (см. constants.ts).
  // errorNatureJson — JSON-массив (может быть отмечено несколько типов
  // ошибок одновременно: грамматические И лексические сразу).
  criteriaTaskCompletion    String?
  criteriaErrorCount        String?
  criteriaErrorNatureJson   String?
  criteriaLogic             String?
  criteriaActiveVocabulary  String?
  criteriaQuestionResponses String?

  // Итоговая оценка — заполняется ТОЛЬКО при подтверждении (ТЗ п.22:
  // "система никогда не завершает оценку сама"). Предварительная оценка
  // (ТЗ п.22) намеренно НЕ хранится отдельным полем — вычисляется на
  // лету из критериев выше (см. analytics/oralGrading.ts), чтобы не
  // могла разойтись с текущими значениями критериев.
  finalGrade     String?
  teacherComment String?

  gradedByTeacherId String?
  gradedByTeacher   User?     @relation("OralAssessmentGradedBy", fields: [gradedByTeacherId], references: [id])
  confirmedAt       DateTime?

  // Только для EXEMPTED (ТЗ п.25 — фиксированная формулировка причины).
  exemptionReason String?
  exemptedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId])
}

// Append-only журнал решений зачёта (ТЗ п.33 — "история не
// перезаписывается": попытки теста, результаты, проверки словаря,
// квалификационные баллы, решения преподавателя, устная часть, смены
// статуса"). Квалификационные баллы и их история уже покрыты
// AchievementAuditLog (Этап 8) — здесь не дублируется. Поля-владельцы —
// простые строки без FK-связи, как у StudentGoalStatusEvent (Этап 7):
// это чисто журнал фактов, не требующий обхода через реляционные поля.
model CreditAuditLog {
  id         String   @id @default(uuid())
  studentId  String
  groupId    String
  entityType String // DICTIONARY | TEST | ORAL
  entityId   String?
  actorId    String
  action     String
  fromValue  String?
  toValue    String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([studentId, groupId])
  @@index([groupId, entityType])
}
